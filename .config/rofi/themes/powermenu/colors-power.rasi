    border-color: #3290A9;
    background-image:            url("/home/joey/wallpapers/miku.jpg", both);
}

#prompt{
      text-color: #CCBCD0;
}

#message {
    background-color:           transparent;
    text-color: #CCBCD0;
}

#window {
   background-color: #00000099;
}

#textbox{
    placeholder-color:           #CCBCD0;
}

